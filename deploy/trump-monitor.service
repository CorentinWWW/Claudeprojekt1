# Fuer die MANUELLE VPS-Installation ohne Docker (README "Option B").
# Passt NICHT zum Docker-Setup ueber deploy/oracle_bootstrap.sh (das nutzt
# docker-compose statt systemd) - Pfade/User hier sind fuer eine eigene
# venv-Installation gedacht, siehe README fuer die vollstaendigen Schritte.
[Unit]
Description=Market Impact Predictor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Anpassen an den tatsächlichen Deploy-Pfad und -User:
User=trump-monitor
WorkingDirectory=/opt/trump-market-monitor
EnvironmentFile=/opt/trump-market-monitor/.env
ExecStart=/opt/trump-market-monitor/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
