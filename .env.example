# --- Pflicht ---
ANTHROPIC_API_KEY=sk-ant-...
# Haiku statt Sonnet: die Klassifikation ist eine strukturierte, schema-gefuehrte
# Aufgabe (Tool-Use mit festem JSON-Schema) - dafuer reicht Haiku gut aus, kostet aber
# nur einen Bruchteil pro Call. Fuer potenziell bessere Einschaetzungsqualitaet auf
# z.B. "claude-sonnet-5" umstellen (mehrere x teurer pro Call).
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_RETRIES=3
CLAUDE_TIMEOUT_SECONDS=30

# --- Telegram Alerts ---
# Bot-Token von @BotFather bekommen, Chat-ID z.B. via https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kurze "Monitor gestartet"-Nachricht beim Boot, um die Verbindung sofort zu pruefen
TELEGRAM_STARTUP_NOTICE=true

# --- Polling / Klassifikation ---
POLL_INTERVAL_SECONDS=60
# Untergrenze fuer die Gesamt-Konfidenz einer Meldung, damit sie ueberhaupt fuer einen
# Alert in Frage kommt.
ALERT_CONFIDENCE_THRESHOLD=0.5
# Praezisions-Filter fuer die Telegram-Alerts (der "nur wenn ich mir sehr sicher bin,
# dass eine bestimmte Aktie hoch/runter geht"-Regler): es wird NUR alarmiert, wenn die
# Meldung mindestens EINEN konkreten Boersenticker mit klarer Long/Short-Richtung UND
# einer Pro-Ticker-Konfidenz >= diesem Wert enthaelt. Reine "marktrelevante" Meldungen
# ohne konkrete, hochsichere Aktie loesen KEINE Nachricht aus.
#   0.90 = sehr streng (Standard - nur die absolut sichersten Trades, teils tagelang keine)
#   0.85 = streng (klare, hochsichere Signale, aber realistisch noch welche)
#   0.80 = moderat (etwas mehr Signale)
#   0    = Filter aus (jede marktrelevante Meldung oberhalb ALERT_CONFIDENCE_THRESHOLD)
ALERT_MIN_TICKER_CONFIDENCE=0.90

# --- Persoenlicher Filter (#10) ---
# Nur diese Ticker melden (Komma-Liste, z.B. "NVDA,AAPL,TSLA"); leer = alle. Analog
# koennen Sektoren gewhitelistet werden (Teilstring, z.B. "Halbleiter,Energie").
# Passt EIN handelbarer Ticker ODER ein Sektor, wird alarmiert.
WATCHLIST_TICKERS=
WATCHLIST_SECTORS=
# Diese Ticker generell nie melden (Komma-Liste), egal wie hoch die Konfidenz.
BLOCKLIST_TICKERS=
# Handelbares Universum / Liquiditaets-Gate: ist diese Positivliste gesetzt (Komma-Liste,
# z.B. deine Broker-Watchlist oder die S&P-100), loesen NUR Ticker daraus einen Alert aus
# - obskure/illiquide Kuerzel fallen heraus. Leer = kein Universum-Filter.
TICKER_UNIVERSE=

# --- Zustell-Gates (alle standardmaessig AUS) ---
# Stale-News-Filter: Meldungen, deren Veroeffentlichung laenger als so viele Minuten
# zurueckliegt, werden gar nicht erst klassifiziert (alte News sind meist eingepreist und
# kosten sonst nur einen Claude-Call). Meldungen ohne Zeitstempel werden nie verworfen.
# 0 = aus.
MAX_NEWS_AGE_MINUTES=0
# Ticker-Cooldown: nach einem Alert wird derselbe Ticker+Richtung fuer so viele Minuten
# nicht erneut alarmiert (verhindert Mehrfach-Einstiege in dieselbe laufende Story). 0 = aus.
TICKER_ALERT_COOLDOWN_MINUTES=0
# Ruhezeiten: in diesem Stundenfenster (lokale Zeit QUIET_HOURS_TZ, Format 'START-ENDE',
# z.B. '23-7') werden nur Alerts mit sehr hoher Ueberzeugung (>= QUIET_HOURS_MIN_CONVICTION,
# 0-100) sofort zugestellt; schwaechere warten bis Fensterende (der Resend-Pfad schickt
# sie dann automatisch nach). Leer = aus.
QUIET_HOURS=
QUIET_HOURS_TZ=Europe/Berlin
QUIET_HOURS_MIN_CONVICTION=90

# --- Alert-Anreicherung (#6/#7/#9 + Ueberzeugungs-Score/erwartete Bewegung/Risiko-Level) ---
# US-Boersen-Session (offen/vor-/nachboerslich/zu) im Alert anzeigen.
ENABLE_MARKET_SESSION_INFO=true
# High-Volatility-Hinweis (Zoelle/Sanktionen/Krieg/Fed etc.) im Alert.
ENABLE_VOLATILITY_FLAG=true
# Inline-Chart-Buttons (TradingView) pro handelbarem Ticker.
ENABLE_CHART_BUTTONS=true
CHART_URL_TEMPLATE=https://www.tradingview.com/chart/?symbol={ticker}
# Verdichteter Ueberzeugungs-Score (0-100) aus Konfidenzen + Frische + Quellen-
# Korroboration + Hedge-/Volatilitaets-Abschlag samt grober, unverbindlicher Positions-
# groessen-Einordnung im Alert anzeigen. Kein zusaetzlicher Claude-Call.
ENABLE_CONVICTION_SCORE=true
# Claude um eine grobe erwartete Bewegung (%) + Horizont bitten und im Alert anzeigen.
# Optionales Gate: nur alarmieren, wenn die geschaetzte Bewegung >= diesem Prozentwert
# ist (0 = aus).
ALERT_MIN_EXPECTED_MOVE_PCT=0
# Historische Pro-Ticker-Trefferquote im Alert anzeigen (braucht ENABLE_PRICE_TRACKING,
# um befuellt zu werden).
ENABLE_HISTORICAL_HITRATE=true
# Vorgeschlagene Stop-Loss-/Take-Profit-Marken aus der heutigen Tagesspanne (unverbindlich,
# nur mit ENABLE_PRICE_TRACKING).
ENABLE_RISK_LEVELS=true

# --- Zweitmeinung fuer Grenzfaelle (#4) ---
# Meldungen mit einer Ticker-Konfidenz knapp um die Schwelle (+/- ESCALATION_BAND)
# noch einmal mit einem staerkeren Modell pruefen. Kostet nur fuer diese Grenzfaelle
# einen Extra-Call (zaehlt gegen das Tages-Limit). Standard AUS.
ENABLE_BORDERLINE_ESCALATION=false
CLAUDE_ESCALATION_MODEL=claude-sonnet-5
ESCALATION_BAND=0.1

# --- Preis-Feedback / Backtesting (#2/#3/#8) ---
# Nach jedem Alert den Kurs der handelbaren Ticker erfassen und nach einem Horizont
# erneut messen -> echte Trefferquote im Dashboard (/api/calibration) und heutige
# Bewegung im Alert. Best-effort ueber Stooq (kostenlos, kein Key). Standard AUS,
# da es von ausgehender Netz-Erreichbarkeit abhaengt und pro Alert HTTP-Calls macht.
ENABLE_PRICE_TRACKING=false
PRICE_OUTCOME_HORIZON_MINUTES=60
# Kurz-Cache fuer Live-Kursabfragen: dieselbe Ticker-Quote wird innerhalb dieses Fensters
# nicht erneut geholt (spart HTTP-Calls). 0 = aus.
PRICE_CACHE_TTL_SECONDS=60
# Woechentlicher Performance-Digest per Telegram (Trefferquote/beste/schlechteste Calls):
# einmal pro Woche am WEEKLY_DIGEST_WEEKDAY (0=Montag..6=Sonntag), ab WEEKLY_DIGEST_MIN_HOUR
# (UTC). Braucht ausgewertete Ergebnisse (ENABLE_PRICE_TRACKING), sonst wird nichts verschickt.
ENABLE_WEEKLY_DIGEST=true
WEEKLY_DIGEST_WEEKDAY=0
WEEKLY_DIGEST_MIN_HOUR=8
# Wie viele Statements GLEICHZEITIG klassifiziert werden. Bei > 1 koennen zwei fast
# zeitgleiche Meldungen zum selben Thema (z.B. von zwei Quellen) sich gegenseitig
# nicht als Duplikat erkennen (der Themen-Kontext waechst erst NACH Abschluss einer
# Klassifikation) und beide einen Alert ausloesen. Standard bewusst 1 (seriell) -
# schliesst dieses Duplikat-Risiko aus, auf Kosten von etwas laengerer
# Verarbeitungszeit bei einem ploetzlichen Nachrichtenschub.
MAX_CONCURRENT_CLASSIFICATIONS=1
# Ab so vielen gleichzeitig alarmwuerdigen Meldungen in einem Zyklus wird zu EINER
# Sammel-Nachricht gebuendelt statt einer Telegram-Nachricht pro Meldung (z.B. bei
# einem ploetzlichen Nachrichtenschub).
ALERT_DIGEST_THRESHOLD=3
# Harter Kostendeckel: mehr als so viele Claude-Calls finden an einem Tag (UTC) nicht
# mehr statt, egal wie viele neue Meldungen eintreffen (jede neue Meldung kostet einen
# Call, auch wenn sie sich danach als Themen-Duplikat herausstellt - die Duplikat-
# erkennung spart Alerts, nicht den Call selbst). Bei einem ploetzlichen
# Nachrichtenschub (z.B. eine grosse Breaking-News-Lage) kann die Zahl neuer Meldungen
# sonst an einem einzigen Tag ueberraschend hohe Kosten verursachen. Default 100
# Calls/Tag ~ max. ca. 0.15-0.25 EUR/Tag bei aktuellen Haiku-4.5-Preisen. Gilt
# persistent ueber einzelne GitHub-Actions-Laeufe hinweg.
MAX_CLASSIFICATIONS_PER_DAY=100
# Prioritaets-Reserve OBERHALB des normalen Tages-Limits: an einem lauten Nachrichtentag
# soll eine wirklich wichtige Meldung nicht stumm untergehen, nur weil das normale Limit
# schon von unwichtigeren Meldungen aufgebraucht wurde. Als "wichtig" gelten (billig und
# OHNE zusaetzlichen Claude-Call bestimmt) direkte Original-Quellen-Posts (z.B. Truth
# Social, falls aktiviert) sowie harte Wirtschaftsthemen (Zoelle, Sanktionen,
# Zinsen/Fed, Executive Orders, Shutdown, Embargo etc.). Solche Meldungen duerfen bis
# zu MAX + PRIORITY Calls/Tag nutzen, normale Meldungen bleiben hart bei MAX gesperrt.
# Absolutes Tages-Maximum = MAX + PRIORITY (Default 100 + 30 = 130). Auf 0 setzen, um
# die Reserve zu deaktivieren (dann ist MAX ein hartes Limit fuer ALLE Meldungen).
PRIORITY_CLASSIFICATIONS_PER_DAY=30

# --- Billiger, Claude-FREIER Relevanz-Vorfilter (erste Trichterstufe) ---
# Seit der Verallgemeinerung (kein Personen-/Themenfilter mehr an den Quellen) kommt
# viel mehr Rohmaterial herein - jede Meldung wuerde sonst einen Claude-Call (und einen
# Slot von MAX_CLASSIFICATIONS_PER_DAY) kosten, der Tagesdeckel waere oft schon
# vormittags erschoepft. Dieser Vorfilter verwirft OFFENSICHTLICHE Nicht-Ereignisse
# (Listicles wie "5 stocks to watch", Ratgeber/How-to, reine Personal-Finance-/Werbe-
# Clickbait) per einfacher Muster-Denylist, BEVOR ein Call ausgegeben wird - so bleibt
# die Abdeckung breit, aber die Kosten sinken. Bewusst KONSERVATIV (hohe Praezision):
# im Zweifel wird durchgelassen, ein Grenzfall kostet nur einen Call und wird danach
# von Claude sauber verworfen; ein echtes Ereignis geht nie verloren. Auf false setzen,
# um jede Rohmeldung direkt an Claude zu geben (mehr Kosten, keine Vorauswahl).
ENABLE_PREFILTER=true

# --- Duplikaterkennung Tier 1: reine Textaehnlichkeit ---
# Verhindert doppelte Alerts, wenn dieselbe Aussage z.B. von GDELT UND RSS oder von
# vielen Portalen wortgleich syndiziert gemeldet wird. Fenster = 24h ("heute").
# Wirkt nur INNERHALB derselben Sprache - GDELT wird deshalb zusaetzlich fest auf
# sourcelang:english eingeschraenkt, damit dieselbe Meldung nicht durch
# fremdsprachige Syndizierung mehrfach als "neues" Statement durchkommt.
DEDUP_SIMILARITY_THRESHOLD=0.82
DEDUP_WINDOW_SECONDS=86400

# --- Duplikaterkennung Tier 2: Themen-/Eskalations-Erkennung via Claude ---
# Bereits heute alarmierte Meldungen werden Claude als Kontext mitgegeben, damit es
# erkennen kann, ob eine neue Meldung im Kern zum selben Thema gehoert (auch bei
# anderem Wortlaut) - nur bei einer echten Eskalation wird trotzdem erneut alarmiert.
TOPIC_CONTEXT_WINDOW_HOURS=24
TOPIC_CONTEXT_MAX_ITEMS=20

# --- Datenquellen an/aus ---
ENABLE_NEWS=true
ENABLE_TRUTH_SOCIAL=true
ENABLE_LIVE_AUDIO=false

# --- Truth Social (Best-Effort, inoffizielle API + Browser-Fallback) ---
# Eine von mehreren optionalen Quellen - frei auf jeden Account einstellbar, nicht
# zwingend Trump. Die News-Feeds (ENABLE_NEWS) decken unabhaengig davon allgemein
# marktrelevante Nachrichten ab.
TRUTH_SOCIAL_HANDLE=realDonaldTrump
# Optional: Bearer-Token falls die unauthentifizierten Endpunkte blockiert werden
TRUTH_SOCIAL_BEARER_TOKEN=
# Playwright/Chromium-Fallback falls der direkte API-Call blockiert wird
TRUTH_SOCIAL_BROWSER_FALLBACK=true
TRUTH_SOCIAL_BROWSER_FALLBACK_MIN_INTERVAL=300

# --- Live-Audio (experimentell, braucht yt-dlp + faster-whisper) ---
# Kommagetrennte Liste von YouTube-Live-URLs, die überwacht werden sollen
# (es gibt keine automatische Erkennung "relevante Person spricht gerade" - muss
# manuell gepflegt werden)
LIVE_AUDIO_STREAM_URLS=
WHISPER_MODEL_SIZE=base

# --- Dashboard ---
DASHBOARD_PORT=8000
# Schuetzt /api/statements, /api/stats und /api/test (Claude-Call + moeglicher
# Telegram-Alert!) mit einem Header "X-API-Key: <wert>". Dringend setzen, wenn
# das Dashboard oeffentlich erreichbar ist (z.B. Oracle-Cloud-Anleitung mit
# offenem Port 8000) - sonst kann jeder, der die IP kennt, Kosten verursachen
# und/oder Telegram-Alerts ausloesen. Einfach eine zufaellige lange Zeichenkette
# eintragen, z.B. per "openssl rand -hex 24" erzeugt.
DASHBOARD_API_KEY=

# DB_PATH bewusst NICHT hier gesetzt: die Docker-Variante hat im Image bereits
# DB_PATH=/data/trump_monitor.db (passend zum Volume-Mount) als Default hinterlegt.
# Wuerde man hier einen Wert eintragen, wuerde er den Docker-Default ueberschreiben
# und die DB liesse sich ausserhalb des Volumes ablegen - beim naechsten
# "docker compose up --build" waere dann der komplette Verlauf weg. Fuer die
# manuelle venv/systemd-Installation (README Option B) reicht der Code-interne
# Default ("trump_monitor.db" im Arbeitsverzeichnis) auch ohne diese Zeile.
# DB_PATH=trump_monitor.db
