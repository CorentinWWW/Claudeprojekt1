# --- Pflicht ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_RETRIES=3
CLAUDE_TIMEOUT_SECONDS=30

# --- Telegram Alerts ---
# Bot-Token von @BotFather bekommen, Chat-ID z.B. via https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kurze "Monitor gestartet"-Nachricht beim Boot, um die Verbindung sofort zu pruefen
TELEGRAM_STARTUP_NOTICE=true

# --- Polling / Klassifikation ---
POLL_INTERVAL_SECONDS=60
ALERT_CONFIDENCE_THRESHOLD=0.5
MAX_CONCURRENT_CLASSIFICATIONS=3
# Ab so vielen gleichzeitig alarmwuerdigen Meldungen in einem Zyklus wird zu EINER
# Sammel-Nachricht gebuendelt statt einer Telegram-Nachricht pro Meldung (z.B. bei
# einem ploetzlichen Nachrichtenschub).
ALERT_DIGEST_THRESHOLD=3

# --- Duplikaterkennung Tier 1: reine Textaehnlichkeit ---
# Verhindert doppelte Alerts, wenn dieselbe Aussage z.B. von GDELT UND RSS oder von
# vielen Portalen wortgleich syndiziert gemeldet wird. Fenster = 24h ("heute").
DEDUP_SIMILARITY_THRESHOLD=0.82
DEDUP_WINDOW_SECONDS=86400

# --- Duplikaterkennung Tier 2: Themen-/Eskalations-Erkennung via Claude ---
# Bereits heute alarmierte Meldungen werden Claude als Kontext mitgegeben, damit es
# erkennen kann, ob eine neue Meldung im Kern zum selben Thema gehoert (auch bei
# anderem Wortlaut) - nur bei einer echten Eskalation wird trotzdem erneut alarmiert.
TOPIC_CONTEXT_WINDOW_HOURS=24
TOPIC_CONTEXT_MAX_ITEMS=20

# --- Datenquellen an/aus ---
ENABLE_NEWS=true
ENABLE_TRUTH_SOCIAL=true
ENABLE_LIVE_AUDIO=false

# --- Truth Social (Best-Effort, inoffizielle API + Browser-Fallback) ---
TRUTH_SOCIAL_HANDLE=realDonaldTrump
# Optional: Bearer-Token falls die unauthentifizierten Endpunkte blockiert werden
TRUTH_SOCIAL_BEARER_TOKEN=
# Playwright/Chromium-Fallback falls der direkte API-Call blockiert wird
TRUTH_SOCIAL_BROWSER_FALLBACK=true
TRUTH_SOCIAL_BROWSER_FALLBACK_MIN_INTERVAL=300

# --- Live-Audio (experimentell, braucht yt-dlp + faster-whisper) ---
# Kommagetrennte Liste von YouTube-Live-URLs, die überwacht werden sollen
# (es gibt keine automatische Erkennung "Trump spricht gerade" - muss manuell gepflegt werden)
LIVE_AUDIO_STREAM_URLS=
WHISPER_MODEL_SIZE=base

# --- Dashboard ---
DASHBOARD_PORT=8000
DB_PATH=trump_monitor.db
